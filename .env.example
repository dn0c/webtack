# WideWeb Environment Variables & API Keys

# Vault location (default: ./vault)
# WIDEWEB_VAULT=./vault

# Google Cloud Storage bucket for digital garden publishing
# WIDEWEB_GCS_BUCKET=my-garden-assets

# Path to gcloud CLI binary (optional, auto-detected from PATH or standard SDK locations)
# GCLOUD_BIN=/usr/local/bin/gcloud

# LLM & Third-Party Enrichment (optional)
# GEMINI_API_KEY=
# SUPADATA_API_KEY=
# ARENA_API_TOKEN=
# INSTAPAPER_ACCESS_TOKEN=
