# WebTack Environment Variables & API Keys
# Copy this file to .env and configure as needed.

# Vault location (default: ./vault)
# WEBTACK_VAULT=./vault

# Google Cloud Storage bucket for digital garden publishing (optional)
# WEBTACK_GCS_BUCKET=my-garden-assets

# ─── Generative AI Enrichment & Summarization (Optional) ───────────────
# WebTack works completely offline with ZERO keys out of the box using:
#   1. Embedded EXIF/IPTC photographer captions
#   2. Upstream web <figcaption> and og:image:alt tags
#   3. Native macOS Vision (Apple Silicon Neural Engine OCR & scene classification)
#
# To enable Level 3 generative AI (crisp 2–3 sentence article summaries dynamically
# labeled with the exact tool used, e.g. [AI Summary: Gemini], [AI Summary: Claude],
# or [AI Summary: OpenAI], plus rich accessibility vision alt-text), configure ONE:
# GEMINI_API_KEY=your_gemini_api_key          # (Recommended - Gemini Flash)
# OPENAI_API_KEY=your_openai_api_key          # (gpt-4o-mini)
# ANTHROPIC_API_KEY=your_anthropic_api_key    # (claude-3-5-haiku)
# GROQ_API_KEY=your_groq_api_key              # (llama-3.3-70b / llama-3.1-8b)
# OPENROUTER_API_KEY=your_openrouter_api_key  # (OpenRouter)

# ─── YouTube Transcripts (Optional) ──────────────────────────────────
# High-throughput captions API (optional)
# SUPADATA_API_KEY=

# ─── Upstream Integrations (Optional) ────────────────────────────────
# See integrations/arena/ and integrations/instapaper/
# ARENA_API_TOKEN=
# ARENA_USER_ID=
# INSTAPAPER_ACCESS_TOKEN=
