{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WideWebAtom",
  "description": "Canonical schema for a WideWeb atom v3 (article, bookmark, video, quote, note, image, file)",
  "type": "object",
  "required": ["id", "kind", "version", "created_at", "curation", "source", "content"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier (timestamp-prefixed random ID)"
    },
    "kind": {
      "type": "string",
      "enum": ["article", "bookmark", "video", "quote", "note", "image", "file"],
      "description": "Primary semantic role and schema discriminator"
    },
    "version": {
      "type": "integer",
      "default": 3
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "description": "Source Layer: origin, attribution, publisher metadata and upstream capture context",
      "properties": {
        "source_url": { "type": ["string", "null"] },
        "source_title": { "type": ["string", "null"] },
        "site_name": { "type": ["string", "null"] },
        "author": { "type": ["string", "null"] },
        "published_at": { "type": ["string", "null"], "format": "date-time" },
        "favicon": { "type": ["string", "null"] },
        "capture_method": {
          "type": ["string", "null"],
          "description": "Tool or pipeline used to ingest this atom (e.g., arena, instapaper, cli, mcp, extension)"
        },
        "capture_id": {
          "type": ["string", "null"],
          "description": "Upstream identifier on the capturing platform (e.g., Are.na block ID or Instapaper bookmark ID)"
        },
        "capture_url": {
          "type": ["string", "null"],
          "description": "Direct link to the captured item on the upstream platform"
        }
      }
    },
    "curation": {
      "type": "object",
      "required": ["atom_title"],
      "properties": {
        "atom_title": { "type": "string" },
        "description": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"], "description": "Legacy alias for description" },
        "tags": {
          "type": "array",
          "description": "Universal lowercase tags (hyphen-separated for multi-word phrases)",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9.\\-]+$"
          },
          "default": []
        },
        "collections": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "visibility": {
          "type": "string",
          "enum": ["public", "shared", "private"],
          "default": "public",
          "description": "Intrinsic egress classification (public: open web; shared: trusted circle/family; private: local machine only)"
        },
        "favorite": { "type": "boolean", "default": false }
      }
    },
    "content": {
      "type": "object",
      "description": "Content Layer: primary text body, offline readable markdown, visual assets, video streams, transcripts and file attachments",
      "properties": {
        "cover_image": {
          "type": ["object", "null"],
          "description": "Universal visual anchor: photo, article OG card, video poster, or PDF preview",
          "properties": {
            "file": { "type": ["string", "null"] },
            "relative_path": { "type": ["string", "null"] },
            "mime_type": { "type": ["string", "null"] },
            "hash": { "type": ["string", "null"] },
            "dimensions": {
              "type": ["object", "null"],
              "properties": {
                "width": { "type": "integer" },
                "height": { "type": "integer" }
              }
            },
            "aspect_ratio": { "type": ["number", "null"] },
            "blurhash": { "type": ["string", "null"] },
            "color_palette": {
              "type": "array",
              "items": { "type": "string" }
            },
            "alt_text": { "type": ["string", "null"] }
          }
        },
        "text": {
          "type": ["object", "string", "null"],
          "properties": {
            "file": { "type": ["string", "null"] },
            "relative_path": { "type": ["string", "null"] },
            "excerpt": { "type": ["string", "null"] },
            "word_count": { "type": ["integer", "null"] }
          }
        },
        "article": {
          "type": ["object", "null"],
          "description": "Offline readable article body extracted via Readability/Trafilatura",
          "properties": {
            "file": { "type": ["string", "null"] },
            "relative_path": { "type": ["string", "null"] },
            "word_count": { "type": ["integer", "null"] },
            "byline": { "type": ["string", "null"] }
          }
        },
        "video": {
          "type": ["object", "null"],
          "properties": {
            "provider": { "type": ["string", "null"] },
            "embed_url": { "type": ["string", "null"] },
            "duration_seconds": { "type": ["integer", "null"] },
            "transcript_file": { "type": ["string", "null"] },
            "transcript_json": { "type": ["string", "null"] },
            "transcript_language": { "type": ["string", "null"] },
            "transcript_is_generated": { "type": ["boolean", "null"] },
            "has_transcript": { "type": "boolean", "default": false }
          }
        },
        "file": {
          "type": ["object", "null"],
          "properties": {
            "filename": { "type": ["string", "null"] },
            "relative_path": { "type": ["string", "null"] },
            "file_size_bytes": { "type": ["integer", "null"] },
            "file_extension": { "type": ["string", "null"] },
            "page_count": { "type": ["integer", "null"] }
          }
        }
      }
    },
    "metadata_json": {
      "type": "object",
      "description": "Custom extensions and open overflow storage. Third-party plugins, scripts, and integrations should store proprietary metadata under namespaced keys (e.g. metadata_json['com.plugin_name'] = {...}) to prevent collisions.",
      "default": {}
    }
  }
}
